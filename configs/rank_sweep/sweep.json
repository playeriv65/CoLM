{
    "name": "rank-sweep",
    "base_config": "configs/rank_sweep/base.json",
    "output_root": "out/rank-sweep",
    "train_overrides": {},
    "arms": [
        {"lora_r": 128, "lora_alpha": 512},
        {"lora_r": 16, "lora_alpha": 64},
        {"lora_r": 16, "lora_alpha": 512},
        {"lora_r": 8, "lora_alpha": 32},
        {"lora_r": 8, "lora_alpha": 512}
    ],
    "eval": {
        "checkpoints": [512, 1024],
        "datasets": ["gsm8k", "math", "numglue", "svamp", "deepmind", "simuleq"],
        "dtype": "float16",
        "shots": 0,
        "stem_flan_type": "pot_prompt",
        "model_max_length": 2048,
        "batch_size": 8,
        "gpu_memory_utilization": 0.3,
        "base_output_dir": "out/rank-sweep/phi-2-base/outputs",
        "limit": null
    },
    "summary_notes": [
        "Step time and training peak memory are secondary metrics: other jobs (evaluations of earlier arms, vLLM at 0.3 of the card) shared GPU 0 during part of each training run, so they are contaminated by concurrency. Loss and accuracy are unaffected."
    ],
    "env": {
        "HF_HUB_OFFLINE": "1",
        "TOKENIZERS_PARALLELISM": "false",
        "VLLM_WORKER_MULTIPROC_METHOD": "spawn"
    },
    "require_env": ["HF_HOME"],
    "local_cache_env": ["HF_HOME", "HF_HUB_CACHE"],
    "require_hf_files": {
        "microsoft/phi-2": [
            "config.json",
            "tokenizer.json",
            "model.safetensors.index.json",
            "model-00001-of-00002.safetensors",
            "model-00002-of-00002.safetensors"
        ]
    }
}
