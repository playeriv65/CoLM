{
    "name": "rank-sweep",
    "base_config": "configs/rank_sweep/base.json",
    "output_root": "out/rank-sweep-v4",
    "train_overrides": {
        "selection_prefix_dtype": "float16",
        "pack_tokens": 1536,
        "train_max_tokens": 1536
    },
    "arms": [
        {"lora_r": 128, "lora_alpha": 512},
        {"lora_r": 16, "lora_alpha": 64},
        {"lora_r": 16, "lora_alpha": 512},
        {"lora_r": 8, "lora_alpha": 32},
        {"lora_r": 8, "lora_alpha": 512}
    ],
    "eval": {
        "checkpoints": [512, 1024],
        "datasets": ["gsm8k", "math", "numglue", "svamp", "deepmind", "simuleq"],
        "dtype": "float16",
        "shots": 0,
        "stem_flan_type": "pot_prompt",
        "max_new_tokens": 1024,
        "batch_size": 8,
        "gpu_memory_utilization": 0.9,
        "base_output_dir": "out/rank-sweep-v4/phi-2-base/outputs",
        "limit": null
    },
    "summary_notes": [
        "Single-GPU rank comparison with the fixed FP16 selection prefix, FP32 suffix, and 1536-token selection and training budgets. Evaluations run alone on the assigned GPU."
    ],
    "env": {
        "HF_HUB_OFFLINE": "1",
        "TOKENIZERS_PARALLELISM": "false",
        "VLLM_WORKER_MULTIPROC_METHOD": "spawn"
    },
    "require_env": ["HF_HOME"],
    "local_cache_env": ["HF_HOME", "HF_HUB_CACHE"],
    "require_hf_files": {
        "microsoft/phi-2": [
            "config.json",
            "tokenizer.json",
            "model.safetensors.index.json",
            "model-00001-of-00002.safetensors",
            "model-00002-of-00002.safetensors"
        ]
    },
    "require_kernels": [
        {
            "repo": "kernels-community/flash-attn2",
            "revision": "81fb77c12b2ad5d69380669b46739d5868614502",
            "version": 3,
            "symbols": ["flash_attn_func", "flash_attn_varlen_func"]
        }
    ]
}
